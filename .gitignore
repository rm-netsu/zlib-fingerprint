zig-out/
.zig-cache/

# Binaries in the binaries/ folder (keep the README, ignore binaries)
binaries/*
!binaries/README.md
!binaries/*.sh
!binaries/*.c

# Vendored third-party source trees: keep the upstream sources as the
# independent reference, ignore anything built inside them
!binaries/vendor/
binaries/vendor/*/obj/
binaries/vendor/*/zopfli

*.idat

# Local reference binary built from scripts/katajainen_ref.c
scripts/katajainen_ref

# Delivery artifacts: built executables and downloaded reference tarballs
outputs/bin-linux-x86_64/
outputs/zopfli-reference-tarballs/*.tar.gz

# Generated benchmark fixtures (scripts/gen_fixtures.py)
fixtures/
fixtures-regression/

# Rebuildable work dirs of the verification harnesses
asan-work/
build-options-work/
outputs/zopfli-references/
*-journal.jsonl
oneshot-ext-journal.jsonl
