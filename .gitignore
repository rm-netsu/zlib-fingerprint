zig-out/
zig-pkg/
.zig-cache/

# The zlib-replicant engine-repository clone used by the differential
# suites (CI checks it out at the tag pinned in build.zig.zon; the
# fetched dependency cache cannot ship those scripts — zon .paths
# exports the engine only)
/zlib-replicant/

# Binaries in the binaries/ folder (keep the README, ignore binaries)
binaries/*
!binaries/README.md
!binaries/*.sh
!binaries/*.c

# Everything under binaries/vendor/ is fetched on demand by
# build-binaries.sh and the delegated package builders (zlib-replicant,
# zopfli-replicant, zlib-ng, miniz, libdeflate, advancecomp); the
# committed zopfli 1.0.3 reference tree now lives inside the
# zopfli-replicant package.
binaries/vendor/

*.idat

__pycache__

# Local reference binary built from scripts/katajainen_ref.c
scripts/katajainen_ref

# Delivery artifacts: built executables and downloaded reference tarballs
outputs/bin-linux-x86_64/
outputs/zopfli-reference-tarballs/*.tar.gz

# Generated benchmark fixtures (scripts/gen_fixtures.py)
fixtures/

# Rebuildable work dirs of the verification harnesses
asan-work/
build-options-work/
outputs/zopfli-references/
*-journal.jsonl
oneshot-ext-journal.jsonl
